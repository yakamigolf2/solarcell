# Copy to .env.local (or run: npx vercel env pull .env.local). Never commit real values: this repo is public.

# Neon Postgres (Vercel -> Storage -> Neon sets these automatically)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
NEON_PROJECT_ID=
# Vercel Blob (Vercel -> Storage -> Blob sets this automatically; store must be public)
BLOB_READ_WRITE_TOKEN=
# Session signing secret: openssl rand -base64 32
AUTH_SECRET=

# Daily encrypted backup (32 random bytes, base64): openssl rand -base64 32
BACKUP_KEY=
# Vercel Cron sends this as a Bearer token to /api/cron/daily
CRON_SECRET=

# Monitor page CPU card: Neon API key scoped to this project
NEON_API_KEY=

# LINE Messaging API notifications (see README: ตั้งค่าแจ้งเตือน LINE)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_TO=

# Optional
APP_URL=https://beg-solarcell.vercel.app
MONITOR_DB_LIMIT_GB=0.5
MONITOR_COMPUTE_LIMIT_HOURS=100
MONITOR_BLOB_LIMIT_GB=1
